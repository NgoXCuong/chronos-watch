DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chronos_watch_db
DB_PORT=3306
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Payment Gateway (VNPAY)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay_return

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Banking Info (VietQR)
BANK_ID=MB
ACCOUNT_NO=your_bank_account_number
ACCOUNT_NAME=YOUR ACCOUNT NAME
VIETQR_TEMPLATE=compact
VIETQR_BASE_URL=https://api.vietqr.io/image

# Email Configuration (SMTP Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
